ARG PHP_VERSION=8.1
FROM bmiops/apache2-php-fpm:$PHP_VERSION-full

ARG APP_DIR=/var/www/app
ARG APP_ENV
ARG PHP_VERSION 
ARG SENTRY_PROJECT_DSN

WORKDIR $APP_DIR
COPY . $APP_DIR/
RUN chown -R www-data:www-data $APP_DIR $APP_DIR/storage $APP_DIR/bootstrap/cache && \
    chmod -R 775 $APP_DIR/storage $APP_DIR/bootstrap/cache && \
    composer install --no-dev --optimize-autoloader && \
    php artisan key:generate && \ 
    php artisan config:clear && \
    php artisan route:clear && \
    php artisan view:clear && \
    php artisan config:cache && \
    php artisan route:cache && \
    php artisan view:cache && \
    chmod +x sentry-laravel-integration.sh

RUN ./sentry-laravel-integration.sh $APP_DIR $SENTRY_PROJECT_DSN $PHP_VERSION $APP_ENV