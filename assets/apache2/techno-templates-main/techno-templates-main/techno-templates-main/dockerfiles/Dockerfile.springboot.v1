FROM maven:3.9.6-eclipse-temurin-17 AS build

ENV SENTRY_URL=https://sentry.bmiwfs-tech.com
ENV JAVA_TOOL_OPTIONS=-Dfile.encoding=UTF8
WORKDIR /app
COPY pom.xml .
# cache Maven repository
#RUN --mount=type=cache,target=/root/.m2 mvn dependency:go-offline -B
RUN mvn dependency:go-offline -B
COPY src/ src/
#RUN --mount=type=cache,target=/root/.m2 mvn clean package -DskipTests -B -T 1C
RUN mvn clean package -DskipTests -B -T 1C

FROM eclipse-temurin:17-jdk
WORKDIR /app
COPY --from=build /app/target/*.jar app.jar
EXPOSE 8080
CMD ["java", "-Djava.net.preferIPv4Stack=true", "-jar", "app.jar"]