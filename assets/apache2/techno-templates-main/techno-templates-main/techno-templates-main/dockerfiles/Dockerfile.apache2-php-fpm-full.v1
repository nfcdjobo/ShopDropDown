FROM ubuntu/apache2:2.4-22.04_beta 
LABEL key="Nade Fabrice"

ARG PHP_VERSION
ENV PHP_VERSION_INSTALLED=${PHP_VERSION}
SHELL ["/bin/bash", "-c"]
WORKDIR /var/www/app

# --- Installation de PHP-FPM et des extensions necessaires ---
RUN apt update && \
    apt install -y software-properties-common dirmngr unzip apt-transport-https ca-certificates && \
    add-apt-repository ppa:ondrej/php && \
    apt update && \
    apt install -y php${PHP_VERSION} php${PHP_VERSION}-fpm php${PHP_VERSION}-cli \
        php${PHP_VERSION}-mbstring php${PHP_VERSION}-curl php${PHP_VERSION}-gd \
        php${PHP_VERSION}-zip php${PHP_VERSION}-soap php${PHP_VERSION}-mysql \
        php${PHP_VERSION}-sqlite3 php${PHP_VERSION}-dev php-pear \
        php${PHP_VERSION}-xml php-json php${PHP_VERSION}-intl&& \
    update-alternatives --set php /usr/bin/php${PHP_VERSION} && \
    a2enmod rewrite && \
    a2enmod ssl && \
    a2enmod proxy_fcgi setenvif && \
    mkdir -p /etc/apache2/certs/ && \
    curl -sS https://getcomposer.org/installer | php -- --install-dir=/usr/local/bin --filename=composer && \
    apt purge -y gnupg2 git unzip software-properties-common && apt autoremove -y && \
    apt clean && \
    rm -rf /var/lib/apt/lists/* && \
    rm -rf /tmp/*

# --- Installation de pilotes Microsoft SQL Server pour Linux ---
RUN curl -sSL -O https://packages.microsoft.com/config/ubuntu/$(grep VERSION_ID /etc/os-release | cut -d '"' -f 2)/packages-microsoft-prod.deb && \
    dpkg -i packages-microsoft-prod.deb && \
    rm packages-microsoft-prod.deb && \
    apt update && \
    ACCEPT_EULA=Y apt install -y msodbcsql17 && \
    ACCEPT_EULA=Y apt install -y mssql-tools && \
    grep -q "export PATH=\"$PATH:/opt/mssql-tools/bin\"" ~/.bashrc ||  echo 'export PATH="$PATH:/opt/mssql-tools/bin"' >> ~/.bashrc && \
    source ~/.bashrc && \
    apt install -y unixodbc-dev && \ 
    update-alternatives --set php /usr/bin/php${PHP_VERSION} && \
    pecl config-set php_ini /etc/php/${PHP_VERSION}/fpm/php.ini && \
    pecl install -f sqlsrv && \ 
    pecl install -f pdo_sqlsrv && \
    printf "; priority=20\nextension=sqlsrv.so\n" | tee /etc/php/${PHP_VERSION}/mods-available/sqlsrv.ini && \
    printf "; priority=30\nextension=pdo_sqlsrv.so\n" | tee /etc/php/${PHP_VERSION}/mods-available/pdo_sqlsrv.ini && \
    phpenmod -v ${PHP_VERSION} sqlsrv pdo_sqlsrv && \
    update-alternatives --set php /usr/bin/php${PHP_VERSION} && \
    apt autoremove -y && \
    apt clean && \
    rm -rf /var/lib/apt/lists/* && \
    rm -rf /tmp/*

# --- Configuration du vhost apache2 ---
COPY ./assets/apache2/000-default.conf /etc/apache2/sites-available/000-default.conf
COPY ./assets/apache2/localhost.crt /etc/apache2/certs/
COPY ./assets/apache2/localhost.key /etc/apache2/certs/

RUN sed -i "s|{{PHP_VERSION}}|${PHP_VERSION}|" /etc/apache2/sites-available/000-default.conf && \
    a2ensite 000-default.conf

EXPOSE 80
EXPOSE 443

CMD ["bash", "-c", "service php$PHP_VERSION_INSTALLED-fpm start && apache2-foreground"]